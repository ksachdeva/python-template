{
  "name": "python-template",
  "dockerFile": "Dockerfile",
  "containerEnv": {
    "LANG": "en_US.UTF-8",
    "DISPLAY": ":99",
    "NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/cloudflare.crt",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "PYTHONPYCACHEPREFIX": "/workspaces/.pycache",
    "REPO_HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "OPENCODE_DB": "/opencode-storage/opencode.db"
  },
  "remoteEnv": {
    "UV_CACHE_DIR": "/tmp/repo-uv-cache",
    "UV_LINK_MODE": "copy",
    "UV_SYSTEM_CERTS": "true",
    "UV_MALWARE_CHECK": "1",
    "UV_PREVIEW_FEATURES": "malware-check,format"
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "forwardPorts": [],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "latest"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers-extra/features/typescript:2": {},
    "ghcr.io/devcontainers-extra/features/ts-node:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {}
  },
  "mounts": [
    "source=devcontainer-zshhistory,target=/commandhistory,type=volume",
    "source=devcontainer-opencode,target=/opencode-storage,type=volume"
  ],
  "postCreateCommand": ["bash", ".devcontainer/scripts/post-create.sh"],
  "customizations": {
    "vscode": {
      "settings": {
        "[python]": {
          "editor.tabSize": 4,
          "editor.insertSpaces": true,
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff",
          "testing.unittestEnabled": false,
          "testing.pytestEnabled": true,
          "testing.pytestArgs": ["tests"],
          "defaultInterpreterPath": "./venv/bin/python"
        },
        "python.terminal.activateEnvironment": false,
        "python-envs.terminal.autoActivationType": "off",
        "[javascript]": {
          "editor.insertSpaces": true,
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/__pycache__": true,
          "**/.mypy_cache": true,
          "**/.ruff_cache": true,
          "**/.pytest_cache": true
        },
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "process"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
